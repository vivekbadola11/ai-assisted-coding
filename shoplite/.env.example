# ShopLite configuration.
# `npm run setup` copies this file to .env (only if .env does not exist yet).
# Values written as <generate:...> are replaced with random FAKE values.
# Nothing in ShopLite talks to a real payment provider.

PORT=4000
DB_PATH=api/data/shoplite.db
LOG_LEVEL=info

# Sandbox payment provider key (FAKE)
PAYMENT_API_KEY=<generate:fake_pay>

# Token required by /api/admin/* endpoints (FAKE)
ADMIN_TOKEN=<generate:fake_admin>
